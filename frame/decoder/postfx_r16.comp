#version 450
// v7.19 full-colour variant (generated from postfx.comp): 16-bit luma, quantised (with dither) to 10 bits.
#extension GL_EXT_samplerless_texture_functions : require
// Steam Link Pyrowave: luma post-filter after the Pyrowave decode (v7.5; v7.8: separate inset / wide deblock).
//   1. Deblock / dering: edge-preserving (bilateral) smoothing whose range sigma follows the frame's bits per pixel,
//      so it does nothing on well-coded frames and cleans up quantization blotches and ringing on starved ones.
//      Edges stronger than a few sigma are left alone.
//   2. Inset sharpening: contrast-adaptive sharpening (CAS-style) on the gaze insets only (even tiles), fading out
//      towards the inset edge, applied to the deblocked result so it does not amplify artifacts.
//   3. Re-dither to 8 bits (the filtered values are no longer on the 8-bit grid).
// One workgroup = 16x16 output pixels; the 5x5 deblock needs a 2-px source halo, the 3x3 sharpen a 1-px halo of
// deblocked values.
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0) uniform texture2D uY;               // decoded luma (R8)
layout(set = 0, binding = 1, r16) writeonly uniform image2D oY;    // filtered luma (R8)
layout(push_constant) uniform PC
{
    float sigma_inset; // deblock range sigma on the insets (even tiles), 0..1 luma units; 0 = none
    float sigma_wide;  // v7.8: deblock range sigma on the wide views (odd tiles)
    float sharpen;     // 0..1 CAS sharpness on the insets; 0 = off
    float r0, r1;      // sharpening full inside r0, fades to 0 at r1 (fractions of the tile half-size)
    float dither;      // 0 or 1
    float tile;        // tile size in px (atlas is tile x 4*tile)
    float y0;          // first row of this dispatch (per-tile dispatches)
    float wide_step;   // v7.8: 1 or 2: spacing of the wide-view taps (2 reaches 8 px, for larger block seams)
} pc;

const int G = 16;
const int HALO = 8;               // enough for the wide kernel at step 2 (taps up to 8 px away)
const int SN = G + 2 * HALO;      // 32
const int FN = G + 2;             // 18: deblocked inset tile incl. 1-px halo for the sharpen
shared float s_src[SN * SN];
shared float s_flt[FN * FN];

// No dynamically indexed constant arrays (on the Adreno compiler they become memory loads): the 4x4 Bayer value is
// built from bits and the taps are written out.
float bayer4(ivec2 p)
{
    int x = p.x & 3, y = p.y & 3, q = x ^ y;
    return float(((q & 1) << 3) | ((y & 1) << 2) | (((q >> 1) & 1) << 1) | ((y >> 1) & 1));
}
// Tukey biweight range weight with c = 2.5 sigma; spatial weights ~ Gaussian.
#define TAP(DX, DY, W0) { float s = s_src[ci + (DY) * SN + (DX)]; float d = s - c; float t = max(1.0 - d * d * invc2, 0.0); \
    float w = (W0) * t * t; acc += w * s; wsum += w; }
// 13-tap diamond (sigma ~1.2 px at step 1)
#define NEAR(S) TAP(S, 0, 0.707) TAP(-(S), 0, 0.707) TAP(0, S, 0.707) TAP(0, -(S), 0.707) \
    TAP(S, S, 0.5) TAP(-(S), S, 0.5) TAP(S, -(S), 0.5) TAP(-(S), -(S), 0.5) \
    TAP(2 * (S), 0, 0.25) TAP(-2 * (S), 0, 0.25) TAP(0, 2 * (S), 0.25) TAP(0, -2 * (S), 0.25)
// v7.8 outer ring for the wide views: 8 taps at ~4 px (x step), so block seams a few px wide get smoothed too
#define FAR(S) TAP(4 * (S), 0, 0.12) TAP(-4 * (S), 0, 0.12) TAP(0, 4 * (S), 0.12) TAP(0, -4 * (S), 0.12) \
    TAP(3 * (S), 3 * (S), 0.1) TAP(-3 * (S), 3 * (S), 0.1) TAP(3 * (S), -3 * (S), 0.1) TAP(-3 * (S), -3 * (S), 0.1)

void main()
{
    ivec2 sz = imageSize(oY);
    ivec2 base = ivec2(gl_WorkGroupID.xy) * G + ivec2(0, int(pc.y0));
    uint li = gl_LocalInvocationIndex;
    int T = int(pc.tile);
    int tile_i = base.y / T;                // whole workgroup is inside one tile (T is a multiple of 16)
    bool inset = (tile_i & 1) == 0;
    int ylo = tile_i * T, yhi = min(ylo + T, sz.y) - 1;

    // Load the source tile with halo; clamp at the borders of the current atlas tile (never mix two views).
    for (uint i = li; i < uint(SN * SN); i += 256u) {
        ivec2 q = base + ivec2(int(i) % SN, int(i) / SN) - HALO;
        q.x = clamp(q.x, 0, sz.x - 1);
        q.y = clamp(q.y, ylo, yhi);
        s_src[i] = texelFetch(uY, q, 0).r;
    }
    barrier();

    ivec2 po = base + ivec2(gl_LocalInvocationID.xy);
    float sigma = inset ? pc.sigma_inset : pc.sigma_wide;
    float invc2 = sigma > 0.0 ? 1.0 / (6.25 * sigma * sigma) : 0.0;

    // Wide views (and insets without sharpening): each thread filters just its own pixel.
    if (!inset || pc.sharpen <= 0.0) {
        if (po.x >= sz.x || po.y >= sz.y) return;
        int ci = (int(gl_LocalInvocationID.y) + HALO) * SN + int(gl_LocalInvocationID.x) + HALO;
        float c = s_src[ci];
        float acc = c, wsum = 1.0;
        if (sigma > 0.0) {
            if (inset) {
                NEAR(1)
            } else if (pc.wide_step > 1.5) {
                NEAR(2) FAR(2)
            } else {
                NEAR(1) FAR(1)
            }
        }
        float dth0 = pc.dither * ((bayer4(po) + 0.5) / 16.0 - 0.5);
        imageStore(oY, po, vec4(clamp(floor(acc / wsum * 1023.0 + 0.5 + dth0), 0.0, 1023.0) / 1023.0));
        return;
    }

    // Insets with sharpening: deblock the 18x18 area (output + 1-px halo), then sharpen.
    for (uint i = li; i < uint(FN * FN); i += 256u) {
        int fx = int(i) % FN, fy = int(i) / FN;
        int ci = (fy - 1 + HALO) * SN + fx - 1 + HALO;
        float c = s_src[ci];
        float v = c;
        if (sigma > 0.0) {
            float acc = c, wsum = 1.0;
            NEAR(1)
            v = acc / wsum;
        }
        s_flt[i] = v;
    }
    barrier();

    ivec2 p = po;
    if (p.x >= sz.x || p.y >= sz.y) return;
    int lx = int(gl_LocalInvocationID.x) + 1, ly = int(gl_LocalInvocationID.y) + 1;
    float e = s_flt[ly * FN + lx];
    float o = e;
    // fade with the distance from the inset centre (the gaze)
    vec2 lp = vec2(p.x, p.y - ylo) + 0.5 - 0.5 * float(T);
    float r = length(lp) / (0.5 * float(T));
    float k = 1.0 - smoothstep(pc.r0, pc.r1, r);
    if (k > 0.0) {
        float b = s_flt[(ly - 1) * FN + lx], d = s_flt[ly * FN + lx - 1];
        float f = s_flt[ly * FN + lx + 1], h = s_flt[(ly + 1) * FN + lx];
        float a = s_flt[(ly - 1) * FN + lx - 1], cc = s_flt[(ly - 1) * FN + lx + 1];
        float g = s_flt[(ly + 1) * FN + lx - 1], ii = s_flt[(ly + 1) * FN + lx + 1];
        float mn = min(min(min(d, e), min(f, b)), h);
        float mn2 = min(mn, min(min(a, cc), min(g, ii)));
        mn += mn2;
        float mx = max(max(max(d, e), max(f, b)), h);
        float mx2 = max(mx, max(max(a, cc), max(g, ii)));
        mx += mx2;
        float amp = sqrt(clamp(min(mn, 2.0 - mx) / max(mx, 1e-4), 0.0, 1.0));
        float peak = -1.0 / mix(8.0, 5.0, clamp(pc.sharpen * k, 0.0, 1.0));
        float w = amp * peak;
        o = clamp((b * w + d * w + f * w + h * w + e) / (1.0 + 4.0 * w), 0.0, 1.0);
    }

    float dth = pc.dither * ((bayer4(p) + 0.5) / 16.0 - 0.5);
    imageStore(oY, p, vec4(clamp(floor(o * 1023.0 + 0.5 + dth), 0.0, 1023.0) / 1023.0));
}
